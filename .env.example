# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Phase 1 needs none of these. They're listed so you know what's coming.

# --- Supabase (Phase 2) ---
# NEXT_PUBLIC_ values are sent to the browser. Only the anon key belongs there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- PayPal (Phase 3) ---
# Server only. sandbox while testing, live when Aura takes real money.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
